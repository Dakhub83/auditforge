# DRAFT generated by AuditForge @{tool_version} from run @{run_id}. Review before use.
# Triggered by: @{triggers}
#
# Policy as code: block unencrypted databases and volumes in a Terraform plan.
#   terraform show -json plan.out > plan.json && conftest test plan.json -p policy/
package auditforge.encryption

import rego.v1

changed contains rc if {
	some rc in input.resource_changes
	not "delete" in rc.change.actions
}

deny contains msg if {
	some rc in changed
	rc.type == "aws_db_instance"
	not rc.change.after.storage_encrypted
	msg := sprintf("%s: RDS storage must be encrypted (storage_encrypted = true)", [rc.address])
}

deny contains msg if {
	some rc in changed
	rc.type == "aws_ebs_volume"
	not rc.change.after.encrypted
	msg := sprintf("%s: EBS volumes must be encrypted (encrypted = true)", [rc.address])
}

deny contains msg if {
	some rc in changed
	rc.type == "aws_kms_key"
	not rc.change.after.enable_key_rotation
	msg := sprintf("%s: KMS keys must rotate (enable_key_rotation = true)", [rc.address])
}
