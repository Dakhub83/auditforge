#!/usr/bin/env python3
"""DRAFT generated by AuditForge @{tool_version} from run @{run_id}. Review before running.

Triggered by: @{triggers}

Approvals and CI results are not stored in git, so the local-clone checks list these pull
requests for a human to confirm. This script gathers that evidence read-only with the GitHub
CLI (`gh pr view`), saves each response unmodified, and writes a SHA-256 manifest.

    gh auth login                      # read access to @{repo} is enough
    python collect_pr_evidence.py
    auditforge attest add --control SOC2:CC8.1 --result pass --procedure "..." \
        --evidence pr-evidence/manifest.json

Changes with no PR number in git (rebase merges, or direct pushes that bypassed review):
@{unnumbered}. Look each commit up in GitHub; a direct push has no PR to collect.
"""

import hashlib
import json
import subprocess
from pathlib import Path

REPO = "@{repo}"
PULL_REQUESTS = @{pull_requests}
FIELDS = "number,title,author,mergedAt,mergedBy,mergeCommit,reviews,statusCheckRollup"
PASSING = {"SUCCESS", "NEUTRAL", "SKIPPED"}


def main() -> None:
    out = Path("pr-evidence")
    out.mkdir(exist_ok=True)
    manifest = {}
    for number in PULL_REQUESTS:
        raw = subprocess.run(
            ["gh", "pr", "view", str(number), "--repo", REPO, "--json", FIELDS],
            capture_output=True,
            check=True,
        ).stdout
        path = out / f"pr-{number}.json"
        path.write_bytes(raw)
        manifest[path.name] = hashlib.sha256(raw).hexdigest()

        pr = json.loads(raw)
        author = (pr.get("author") or {}).get("login")
        approvers = sorted(
            {
                (r.get("author") or {}).get("login")
                for r in pr.get("reviews") or []
                if r.get("state") == "APPROVED" and (r.get("author") or {}).get("login") != author
            }
        )
        not_passing = [
            c.get("name") or c.get("context")
            for c in pr.get("statusCheckRollup") or []
            if (c.get("conclusion") or c.get("state")) not in PASSING
        ]
        print(f"#{number}: independent approvers {approvers or 'NONE'}; CI not passing {not_passing or 'none'}")

    (out / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
    print(f"Saved {len(manifest)} responses to {out}/ with manifest.json")


if __name__ == "__main__":
    main()
