# DRAFT generated by AuditForge @{tool_version} from run @{run_id}. Review before applying.
# Triggered by: @{triggers}
#
# Makes "@{branch}" accept changes only through an approved, CI-green pull request, with no
# administrator bypass (SOC 2 CC8.1, ISO 27001 A.8.32, NIST CM-3/CM-5, SOX ITGC program change).
# Requires a token that can administer the repository; run it through your normal change process.

terraform {
  required_providers {
    github = {
      source  = "integrations/github"
      version = "~> 6.0"
    }
  }
}

data "github_repository" "target" {
  full_name = "@{repo}"
}

resource "github_branch_protection" "@{tf_branch}" {
  repository_id = data.github_repository.target.node_id
  pattern       = "@{branch}"

  enforce_admins         = true  # administrators follow the same rules (GH-BP-05, direct pushes)
  require_signed_commits = true  # GH-BP-04
  allows_force_pushes    = false
  allows_deletions       = false

  required_pull_request_reviews {
    required_approving_review_count = 1    # GH-BP-02; consider 2 for critical systems
    dismiss_stale_reviews           = true # GH-BP-03
    require_last_push_approval      = true # whoever pushed last cannot be the only approver
  }

  required_status_checks {
    strict   = true
    contexts = [] # TODO: names of the CI checks that must pass before merge (GH-CM-02 / GIT-CM-02)
  }
}
