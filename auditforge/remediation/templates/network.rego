	some rc in changed
	rc.type == "aws_security_group"
	some rule in as_array(object.get(rc.change.after, "ingress", []))
	cidrs := array.concat(
		as_array(object.get(rule, "cidr_blocks", [])),
		as_array(object.get(rule, "ipv6_cidr_blocks", [])),
	)
	some cidr in cidrs
	cidr in open_cidrs
	some port in admin_ports
	rule.from_port <= port
	port <= rule.to_port
	msg := sprintf("%s: port %d is open to %s", [rc.address, port, cidr])
}

