# DRAFT generated by AuditForge @{tool_version} from run @{run_id}. Review before use.
# Triggered by: @{triggers}
#
# Policy as code: stops a Terraform change from weakening branch protection again.
#   terraform show -json plan.out > plan.json && conftest test plan.json -p policy/
package auditforge.branch_protection

import rego.v1

protections contains rc if {
	some rc in input.resource_changes
	rc.type == "github_branch_protection"
	not "delete" in rc.change.actions
}

deny contains msg if {
	some rc in protections
	not rc.change.after.enforce_admins
	msg := sprintf("%s: enforce_admins must be true so administrators cannot bypass review", [rc.address])
}

deny contains msg if {
	some rc in protections
	count(object.get(rc.change.after, "required_pull_request_reviews", [])) == 0
	msg := sprintf("%s: pull request reviews must be required", [rc.address])
}

deny contains msg if {
	some rc in protections
	some reviews in rc.change.after.required_pull_request_reviews
	reviews.required_approving_review_count < 1
	msg := sprintf("%s: at least one approving review must be required", [rc.address])
}

deny contains msg if {
	some rc in protections
	some reviews in rc.change.after.required_pull_request_reviews
	not reviews.dismiss_stale_reviews
	msg := sprintf("%s: stale approvals must be dismissed when new commits are pushed", [rc.address])
}

deny contains msg if {
	some rc in protections
	rc.change.after.allows_force_pushes
	msg := sprintf("%s: force pushes rewrite history and must be blocked", [rc.address])
}
